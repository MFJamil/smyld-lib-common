{
    "compilerOptions": {
      "sourceMap": true,
      "module": "ESNext",
      "target": "ESNext",
      "declaration": true,
      "declarationDir": "./dist",
      "outDir": "./dist",
      "moduleResolution": "Node",
      "lib": ["ES2017","es7","ES6","DOM"],
      "esModuleInterop": true,
      "noImplicitAny": true,
      "skipLibCheck": true
    },
    "typedocOptions":{
        "mode":"modules",
        "out": "docs"
    },
    "include": [
      "src/**/*"
    ],
    "exclude": ["node_modules","dist"]
  }